---
import type { CollectionEntry } from 'astro:content';

interface Props {
	keynotes: CollectionEntry<'speakers'>[];
}

const { keynotes } = Astro.props;
---

<!-- Single-instance per page: the script below looks up this carousel via
     getElementById, so only render one KeynoteCarousel per page. -->
{keynotes.length > 0 && (
	<div
		id="keynote-carousel"
		role="region"
		aria-roledescription="carousel"
		aria-label="Keynote speakers"
		class="max-w-2xl mx-auto mb-10"
	>
		<div class="grid transition-[height] duration-500 motion-reduce:transition-none overflow-hidden" aria-live="off" data-live>
			{keynotes.map((keynote, i) => (
				<div
					role="group"
					aria-roledescription="slide"
					aria-label={`${i + 1} of ${keynotes.length}`}
					aria-hidden={i === 0 ? undefined : 'true'}
					inert={i === 0 ? undefined : true}
					data-slide={i}
					class:list={[
						'col-start-1 row-start-1 self-start bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 text-left shadow-sm transition-opacity duration-500 motion-reduce:transition-none',
						i === 0 ? '' : 'opacity-0 pointer-events-none',
					]}
				>
					<p class="text-pink font-bold text-xs uppercase tracking-[0.2em] mb-5">Featured Keynote</p>
					<div class="flex flex-col sm:flex-row gap-6 items-start">
						{keynote.data.photo && (
							<img
								src={keynote.data.photo.src}
								width={keynote.data.photo.width}
								height={keynote.data.photo.height}
								alt={keynote.data.name}
								class="w-32 h-32 rounded-full object-cover flex-shrink-0 mx-auto sm:mx-0"
							/>
						)}
						<div class="flex-1">
							<h3 class="text-2xl font-bold text-navy mb-1">{keynote.data.name}</h3>
							<p class="text-teal text-sm font-medium mb-3">{keynote.data.title}</p>
							<p class="text-navy font-semibold mb-3">"{keynote.data.talkName}"</p>
							{/* Renders raw HTML from the speaker's bio field in the content collection YAML. */}
							<p id={`keynote-bio-${i}`} data-bio class="line-clamp-4 text-gray-600 text-sm leading-relaxed [&_a]:text-teal [&_a]:underline hover:[&_a]:text-teal/80" set:html={keynote.data.bio}></p>
							<button
								type="button"
								data-bio-toggle
								aria-expanded="false"
								aria-controls={`keynote-bio-${i}`}
								class="hidden mt-2 text-teal text-sm font-medium underline hover:text-teal/80"
							>Read more</button>
						</div>
					</div>
				</div>
			))}
		</div>
		{keynotes.length > 1 && (
			<div class="flex items-center justify-center gap-3 mt-4">
				<div class="flex gap-0">
					{keynotes.map((keynote, i) => (
						<button
							type="button"
							data-dot={i}
							aria-label={`Show ${keynote.data.name}`}
							aria-current={i === 0 ? 'true' : undefined}
							class="group w-6 h-6 flex items-center justify-center rounded-full"
						>
							<span class="w-2.5 h-2.5 rounded-full transition-colors bg-gray-300 group-hover:bg-gray-400 group-aria-[current=true]:bg-pink"></span>
						</button>
					))}
				</div>
				<button
					type="button"
					data-pause
					aria-label="Pause automatic rotation"
					class="w-6 h-6 flex items-center justify-center rounded-full text-gray-400 hover:text-pink hover:bg-gray-100 transition-colors"
				>
					<svg data-icon-pause xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true">
						<rect x="2" y="1" width="4" height="14" rx="1"></rect>
						<rect x="10" y="1" width="4" height="14" rx="1"></rect>
					</svg>
					<svg data-icon-play xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="10" height="10" fill="currentColor" aria-hidden="true" class="hidden">
						<path d="M3 1.5v13l11-6.5-11-6.5z"></path>
					</svg>
				</button>
			</div>
		)}
	</div>
)}

<script>
	const carousel = document.getElementById('keynote-carousel');
	const slides = carousel ? [...carousel.querySelectorAll<HTMLElement>('[data-slide]')] : [];
	const dots = carousel ? [...carousel.querySelectorAll<HTMLElement>('[data-dot]')] : [];
	const liveRegion = carousel?.querySelector<HTMLElement>('[data-live]') ?? null;
	const pauseButton = carousel?.querySelector<HTMLButtonElement>('[data-pause]') ?? null;
	const pauseIcon = pauseButton?.querySelector<HTMLElement>('[data-icon-pause]') ?? null;
	const playIcon = pauseButton?.querySelector<HTMLElement>('[data-icon-play]') ?? null;

	let current = 0;

	// Slides self-start instead of stretching, so a short bio leaves no
	// white space inside its card; the wrapper's height follows the
	// active slide (animated alongside the crossfade, clipping the
	// taller invisible slides via overflow-hidden). With a single slide
	// the wrapper auto-sizes, so no explicit height is needed.
	function setHeight() {
		if (liveRegion && slides.length > 1) liveRegion.style.height = `${slides[current].offsetHeight}px`;
	}

	// Bios are clamped to a fixed number of lines so every card renders at
	// a near-uniform height; a Read more toggle reveals the full text.
	function bioParts(slide: HTMLElement) {
		return {
			bio: slide.querySelector<HTMLElement>('[data-bio]'),
			toggle: slide.querySelector<HTMLButtonElement>('[data-bio-toggle]'),
		};
	}

	// line-clamp only hides overflow visually: links below the clip would
	// otherwise stay keyboard-focusable while invisible (and focusing them
	// makes the browser fight the clip). Take anchors that sit below the
	// clamped bio's visible box out of the tab order until expansion.
	function syncBioLinkFocus(slide: HTMLElement) {
		const { bio } = bioParts(slide);
		if (!bio) return;
		const clamped = bio.classList.contains('line-clamp-4');
		const visibleBottom = bio.getBoundingClientRect().bottom;
		for (const a of bio.querySelectorAll('a')) {
			if (clamped && a.getBoundingClientRect().bottom > visibleBottom + 1) a.tabIndex = -1;
			else a.removeAttribute('tabindex');
		}
	}

	function collapseBio(slide: HTMLElement) {
		const { bio, toggle } = bioParts(slide);
		if (!bio || !toggle) return;
		bio.classList.add('line-clamp-4');
		toggle.setAttribute('aria-expanded', 'false');
		toggle.textContent = 'Read more';
		syncBioLinkFocus(slide);
	}

	// Equalize all cards to the tallest clamped slide via min-height, so the
	// wrapper (and everything below it) never moves as the carousel rotates —
	// small differences like a two-line title would otherwise shift layout.
	// An expanded slide is excluded from the measurement (its natural height
	// is inflated) but still receives the shared min-height, which it already
	// exceeds. Only the active slide can be expanded, so whenever the active
	// slide is clamped the measurement covers every slide.
	function syncCardHeights() {
		if (slides.length > 1) {
			for (const slide of slides) slide.style.minHeight = '';
			const max = Math.max(
				...slides
					.filter((s) => bioParts(s).toggle?.getAttribute('aria-expanded') !== 'true')
					.map((s) => s.offsetHeight),
			);
			for (const slide of slides) slide.style.minHeight = `${max}px`;
		}
		setHeight();
	}

	// Show each toggle only when its clamped bio actually overflows, so a
	// short bio gets no dead button. Expanded bios are skipped: they never
	// overflow, and hiding their toggle would strand them open.
	function syncToggleVisibility() {
		for (const slide of slides) {
			syncBioLinkFocus(slide);
			const { bio, toggle } = bioParts(slide);
			if (!bio || !toggle || toggle.getAttribute('aria-expanded') === 'true') continue;
			toggle.classList.toggle('hidden', bio.scrollHeight <= bio.clientHeight + 1);
		}
	}

	for (const slide of slides) {
		const { bio, toggle } = bioParts(slide);
		if (!bio || !toggle) continue;
		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			bio.classList.toggle('line-clamp-4', expanded);
			toggle.setAttribute('aria-expanded', String(!expanded));
			toggle.textContent = expanded ? 'Read more' : 'Show less';
			syncBioLinkFocus(slide);
			setHeight();
		});
	}

	if (carousel && slides.length > 0) {
		window.addEventListener('resize', syncToggleVisibility);
		window.addEventListener('load', syncToggleVisibility);
		syncToggleVisibility();
	}

	if (carousel && slides.length > 1) {
		const INTERVAL = 6000;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let timer: number | undefined;
		let hovered = false;
		let focused = false;
		let paused = false;

		function show(i: number) {
			collapseBio(slides[current]);
			slides[current].classList.add('opacity-0', 'pointer-events-none');
			slides[current].setAttribute('aria-hidden', 'true');
			slides[current].inert = true;
			dots[current].removeAttribute('aria-current');
			current = i;
			slides[current].classList.remove('opacity-0', 'pointer-events-none');
			slides[current].removeAttribute('aria-hidden');
			slides[current].inert = false;
			dots[current].setAttribute('aria-current', 'true');
			setHeight();
		}

		function stop() {
			if (timer !== undefined) {
				clearInterval(timer);
				timer = undefined;
			}
		}

		function maybeStart() {
			if (timer !== undefined || hovered || focused || paused || document.hidden || reducedMotion.matches) return;
			timer = window.setInterval(() => show((current + 1) % slides.length), INTERVAL);
		}

		// The pause button reflects `paused` ALONE, never `reducedMotion`, so
		// every click gives visible feedback and the flag can't silently
		// drift out of sync with what the button shows (if it also reacted
		// to reduced-motion, clicking while reduced motion is on would look
		// like a no-op, and a stale `paused` could permanently block
		// rotation after reduced motion is turned back off). aria-live is
		// broader: it goes "polite" for ANY persistent stop (explicit pause
		// or reduced motion) since both mean rotation will not self-resume.
		// Transient hover/focus stops deliberately do NOT flip aria-live to
		// "polite" — only a stop that will not self-resume should announce
		// itself, otherwise a sighted user's cursor crossing the carousel
		// would spam screen readers with "polite" region churn.
		function syncPersistentState() {
			const liveStopped = paused || reducedMotion.matches;
			liveRegion?.setAttribute('aria-live', liveStopped ? 'polite' : 'off');
			if (pauseButton) {
				pauseButton.setAttribute('aria-label', paused ? 'Resume automatic rotation' : 'Pause automatic rotation');
				pauseIcon?.classList.toggle('hidden', paused);
				playIcon?.classList.toggle('hidden', !paused);
			}
		}

		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				show(i);
				stop();
				maybeStart();
			}),
		);
		pauseButton?.addEventListener('click', () => {
			paused = !paused;
			if (paused) stop();
			else maybeStart();
			syncPersistentState();
		});
		carousel.addEventListener('mouseenter', () => {
			hovered = true;
			stop();
		});
		carousel.addEventListener('mouseleave', () => {
			hovered = false;
			maybeStart();
		});
		carousel.addEventListener('focusin', () => {
			focused = true;
			stop();
		});
		carousel.addEventListener('focusout', (e) => {
			if (!carousel.contains(e.relatedTarget as Node)) {
				focused = false;
				maybeStart();
			}
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else maybeStart();
		});
		reducedMotion.addEventListener('change', () => {
			if (reducedMotion.matches) stop();
			else maybeStart();
			syncPersistentState();
		});

		window.addEventListener('resize', syncCardHeights);
		window.addEventListener('load', syncCardHeights);

		syncPersistentState();
		syncCardHeights();
		maybeStart();
	}
</script>
