---
import cover from '../assets/hyperadaptive-cover.jpg';

interface Props {
	class?: string;
	cta?: boolean;
}

const { class: className = 'max-w-4xl mb-12', cta = true } = Astro.props;

const bookUrl = 'https://itrevolution.com/product/hyperadaptive/';
---

<!-- Free Hyperadaptive book with registration -->
<div class:list={['mx-auto w-full', className]}>
	<div class="bg-teal/10 border border-teal/30 rounded-xl p-6 flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
		<a href={bookUrl} target="_blank" rel="noopener" class="shrink-0">
			<img
				src={cover.src}
				width={cover.width}
				height={cover.height}
				alt="Hyperadaptive book cover"
				class="w-16 sm:w-20 h-auto rounded shadow-sm"
			/>
		</a>
		<div class="flex-1">
			<p class="text-pink font-bold text-xs uppercase tracking-wider mb-1">Free with registration</p>
			<h2 class="text-lg font-bold text-navy mb-1">Take home <em>Hyperadaptive</em></h2>
			<p class="text-gray-700 text-sm leading-relaxed">
				Every registered attendee receives a free printed copy of <a href={bookUrl} target="_blank" rel="noopener" class="text-teal underline hover:text-teal-dark"><em>Hyperadaptive: Rewiring the Enterprise to Become AI-Native</em></a> by featured keynote speaker Melissa M. Reeve. <strong class="text-navy">Meet Melissa and get your copy signed</strong> during the Day&nbsp;2 lunch break, right after her keynote.
			</p>
		</div>
		{cta && (
			<a
				href="/registration"
				class="shrink-0 bg-teal text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-teal-dark transition-colors"
			>
				Register now &rarr;
			</a>
		)}
	</div>
</div>
