---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import KeynoteCarousel from '../components/KeynoteCarousel.astro';
import BookGiveawayCTA from '../components/BookGiveawayCTA.astro';
import "../styles/global.css";
import logo from '../assets/logo-landscape.png';
import { getKeynotes } from '../lib/keynotes';

const keynotes = await getKeynotes();
---

<Layout>
	<Nav />

	<!-- Hero -->
	<section class="relative bg-gray-50 overflow-hidden flex-1">
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute -top-40 -right-40 w-80 h-80 bg-teal/10 rounded-full blur-3xl"></div>
			<div class="absolute top-1/2 -left-40 w-96 h-96 bg-pink/8 rounded-full blur-3xl"></div>
			<div class="absolute -bottom-40 right-1/3 w-80 h-80 bg-teal/10 rounded-full blur-3xl"></div>
		</div>

		<div class="relative z-10 max-w-4xl mx-auto px-6 pt-8 pb-10 text-center">
			<!-- Origin label -->
			<p class="text-sm text-gray-400 italic mb-6">Formerly DevOpsDays DC</p>

			<!-- Logo -->
			<img src={logo.src} alt="DC State of the Stack 2026 — Shipping Software in the Age of AI" class="mx-auto w-full mb-6" />

			<!-- Tagline + Description condensed -->
			<p class="text-lg sm:text-xl text-teal font-medium mb-3 max-w-2xl mx-auto">
				For people who design, build, operate, and govern modern systems.
			</p>
			<p class="text-base text-gray-500 mb-6 max-w-2xl mx-auto leading-relaxed">
				A community-driven technology conference rooted in the DC region, bringing together practitioners from engineering, operations, security, product, and adjacent disciplines to explore how real systems work in the real world. Each year, we engage with the technologies and practices shaping our industry — grounded in experience, tradeoffs, and real constraints. <span class="text-navy font-medium">Substance over spectacle. Learning that carries forward into everyday work.</span>
			</p>

			<a href="/registration"
			   class="block w-full max-w-2xl mx-auto bg-pink text-white font-semibold px-5 py-3 rounded-lg hover:bg-pink-dark transition-colors text-center mb-8">
				Register Now &rarr;
			</a>

			<!-- Event details cards -->
			<div class="grid grid-cols-4 gap-3 max-w-2xl mx-auto mb-8">
				<div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
					<div class="text-teal font-bold text-xs uppercase tracking-wider mb-0.5">When</div>
					<div class="text-navy font-semibold">Sep 16-17, 2026</div>
				</div>
				<a href="https://maps.google.com/?q=1730+E+St+NW,+Washington,+DC+20006" target="_blank" rel="noopener" class="col-span-2 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-pink hover:shadow-sm transition-all">
					<div class="text-pink font-bold text-xs uppercase tracking-wider mb-0.5">Where</div>
					<div class="text-navy font-semibold">American Red Cross</div>
					<div class="text-navy text-sm">1730 E St NW, Washington, DC 20006</div>
				</a>
				<div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
					<div class="text-teal font-bold text-xs uppercase tracking-wider mb-0.5">Who</div>
					<div class="text-navy font-semibold">You</div>
				</div>
			</div>

			<!-- 2026 Theme -->
			<div class="bg-gradient-to-br from-teal to-pink rounded-2xl px-8 py-10 max-w-2xl mx-auto mb-10 text-center text-white shadow-sm">
				<p class="text-xs font-bold uppercase tracking-[0.2em] mb-4 text-white/80">2026 Theme</p>
				<h2 class="text-3xl sm:text-4xl font-bold mb-5 leading-tight">Shipping Software in the Age of AI</h2>
				<p class="text-base sm:text-lg leading-relaxed text-white/95 max-w-xl mx-auto">
					AI is reshaping how software is designed, built, operated, and governed — sometimes in useful ways, sometimes not. This year's program looks at what's actually happening in practice across the stack: where AI is earning its place in real systems, where it isn't, and what's changing for the people doing the work.
				</p>
			</div>

			<!-- Keynotes -->
			<KeynoteCarousel keynotes={keynotes} />

			<!-- Free book with registration -->
			<BookGiveawayCTA class="max-w-2xl mb-10" cta={false} />

			<!-- Registration Banner -->
			<div class="bg-pink/10 border border-pink/30 rounded-2xl px-6 py-5 max-w-2xl mx-auto mb-4 text-left">
				<div class="flex items-start gap-4">
					<div class="flex-1">
						<p class="text-pink-dark font-bold text-xs uppercase tracking-wider mb-1">Registration — Now Open</p>
						<p class="text-navy font-semibold text-lg mb-1">Grab your ticket before they're gone.</p>
						<p class="text-gray-600 text-sm leading-relaxed mb-3">
							Join us September 16-17, 2026 in Washington, DC for two days of real talk from practitioners. Early bird pricing available now.
						</p>
						<a href="/registration"
						   class="inline-block bg-pink text-white text-sm font-semibold px-5 py-2 rounded-lg hover:bg-pink-dark transition-colors">
							Register Now &rarr;
						</a>
					</div>
				</div>
			</div>

			<!-- Sponsor Banner -->
			<div class="bg-navy/5 border border-navy/20 rounded-2xl px-6 py-5 max-w-2xl mx-auto mb-10 text-left">
				<div class="flex items-start gap-4">
					<div class="flex-1">
						<p class="text-navy font-bold text-xs uppercase tracking-wider mb-1">Sponsorship — Now Available</p>
						<p class="text-navy font-semibold text-lg mb-1">Be part of something that matters.</p>
						<p class="text-gray-600 text-sm leading-relaxed mb-3">
							Sponsoring DC State of the Stack is an opportunity to engage with practitioners who care deeply about how systems actually work — engineers, operators, and leaders from across the DC region doing serious technical work.
						</p>
						<a href="/sponsors"
						   class="inline-block bg-navy text-white text-sm font-semibold px-5 py-2 rounded-lg hover:bg-navy/80 transition-colors">
							Become a Sponsor &rarr;
						</a>
					</div>
				</div>
			</div>

			<!-- Topics preview -->
          <div class="pt-12 border-t border-white/10">
            <p class="text-sm text-slate-600 uppercase tracking-wider font-semibold mb-6">Exploring the Full Stack</p>
            <div class="flex flex-wrap justify-center gap-3">
              {['Platform Engineering', 'AI & ML Ops', 'Security', 'Cloud Native', 'DevOps', 'Data Engineering', 'Developer Experience', 'Product Delivery', 'People', 'Leadership', 'Compliance', 'Quality Engineering'].map(topic => (
                <span class="px-4 py-2 bg-pink border border-pink-700/10 rounded-full text-sm text-white hover:bg-teal hover:text-white transition-colors cursor-default">
                  {topic}
                </span>
              ))}
            </div>
          </div>

		  <!-- Origin note -->
		  <p class="mt-12 text-sm text-gray-400">
			Brought to you by the same team that ran <span class="text-navy font-medium">DevOpsDays DC</span> for years. Same great community. Broader vision.
		  </p>
		</div>
	</section>

	<Footer />
</Layout>
